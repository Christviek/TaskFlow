
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #20251f;
  background: #f7f8f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --green: #416b4d;
  --green-dark: #2f5039;
  --green-light: #e8f0e7;
  --muted: #858a82;
  --border: #e8eae5;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
select {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
a:focus-visible {
  outline: 3px solid #92b89a;
  outline-offset: 3px;
}

.app {
  min-height: 100vh;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 245px;
  padding: 30px 22px;
  background: var(--white);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #20251f;
  text-decoration: none;
  font-family: 'Manrope', sans-serif;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.8px;
  margin-bottom: 53px;
}

.brand-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: white;
  background: var(--green);
  font-size: 19px;
}

.nav-heading,
.eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: var(--muted);
}

.nav-heading {
  margin: 0 0 15px 10px;
}

.sidebar nav {
  display: grid;
  gap: 7px;
}

.nav-link {
  padding: 12px;
  border-radius: 9px;
  color: #73786f;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}

.nav-link.active,
.nav-link:hover {
  background: var(--green-light);
  color: var(--green-dark);
}

.sidebar-bottom {
  margin-top: auto;
  padding: 15px 0 0;
}

.sidebar-note {
  margin-left: 10px;
  font-size: 12px;
  color: var(--muted);
}

.main-content {
  max-width: 1500px;
  margin-left: 245px;
  padding: 38px 52px 24px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
}

.eyebrow {
  margin: 0 0 9px;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2,
h3 {
  font-family: 'Manrope', sans-serif;
  letter-spacing: -0.7px;
}

h1 {
  margin-bottom: 0;
  font-size: 28px;
  font-weight: 800;
}

.avatar {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #e7ede4;
  color: var(--green-dark);
  font-weight: 700;
}

.welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 185px;
  padding: 30px 36px;
  margin-bottom: 25px;
  overflow: hidden;
  border-radius: 16px;
  color: white;
  background: linear-gradient(115deg, #365c41, #64836a);
}

.welcome .eyebrow {
  color: #d5e4d5;
}

.welcome h2 {
  font-size: 29px;
  margin-bottom: 10px;
}

.welcome p:last-child {
  margin-bottom: 0;
  color: #e1ebe0;
  font-size: 13px;
}

.welcome-mark {
  font-size: 110px;
  line-height: 1;
  color: #ffffff24;
  margin-right: 12px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 39px;
}

.stat-card {
  padding: 23px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--white);
}

.stat-card p {
  margin-bottom: 13px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}

.stat-card strong {
  font-family: 'Manrope', sans-serif;
  font-size: 30px;
  font-weight: 800;
}

.task-section {
  padding: 0;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 23px;
}

.section-heading h2 {
  margin-bottom: 0;
  font-size: 23px;
}

.primary-button,
.secondary-button {
  min-height: 41px;
  padding: 0 17px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  transition: background 0.15s ease, transform 0.15s ease;
}

.primary-button {
  color: white;
  border: 1px solid var(--green);
  background: var(--green);
}

.primary-button:hover {
  background: var(--green-dark);
}

.secondary-button {
  color: #41463f;
  border: 1px solid var(--border);
  background: white;
}

.secondary-button:hover {
  background: #f4f5f1;
}

.primary-button:active,
.secondary-button:active {
  transform: translateY(1px);
}

.task-form {
  padding: 24px;
  margin-bottom: 22px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: white;
}

.task-form[hidden] {
  display: none;
}

.task-form h3 {
  font-size: 18px;
  margin-bottom: 22px;
}

.task-form label {
  display: block;
  margin-bottom: 8px;
  color: #4d534b;
  font-size: 12px;
  font-weight: 700;
}

.task-form input,
.task-form textarea,
.task-form select,
.task-toolbar input,
.task-toolbar select {
  width: 100%;
  min-height: 42px;
  padding: 10px 12px;
  border: 1px solid #e1e4dd;
  border-radius: 8px;
  background: white;
  color: #282d27;
  font-size: 12px;
}

.task-form input,
.task-form textarea,
.task-form select {
  margin-bottom: 17px;
}

.task-form textarea {
  min-height: 85px;
  resize: vertical;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 4px;
}

.task-toolbar {
  display: grid;
  grid-template-columns: minmax(150px, 1fr) 155px 155px;
  gap: 12px;
  margin-bottom: 18px;
}

.task-list {
  display: grid;
  gap: 12px;
}

.empty-state {
  padding: 52px 20px;
  text-align: center;
  border: 1px dashed #dce1d7;
  border-radius: 13px;
  background: #fbfcfa;
}

.empty-state > span {
  display: inline-grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin-bottom: 12px;
  border-radius: 13px;
  background: var(--green-light);
  color: var(--green);
  font-size: 22px;
}

.empty-state h3 {
  margin-bottom: 7px;
  font-size: 16px;
}

.empty-state p {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 12px;
}

.task-card {
  padding: 19px 20px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: white;
}

.task-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.task-card h3 {
  margin-bottom: 7px;
  font-size: 15px;
  overflow-wrap: anywhere;
}

.task-description {
  margin-bottom: 13px;
  color: #777d73;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 700;
}

.priority-high {
  color: #a43d35;
  background: #fbe9e7;
}

.priority-medium {
  color: #95671e;
  background: #fbf0d8;
}

.priority-low {
  color: #3c7650;
  background: #e8f4e9;
}

.status-todo {
  color: #61665f;
  background: #eff0ed;
}

.status-in-progress {
  color: #355f9b;
  background: #e8effb;
}

.status-done {
  color: #35734b;
  background: #e5f3e8;
}

.task-date {
  color: #858a82;
  font-size: 11px;
}

.task-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
  padding-top: 13px;
  border-top: 1px solid #f0f1ed;
}

.task-controls button,
.task-controls select {
  padding: 7px 9px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: white;
  color: #555b52;
  font-size: 11px;
}

.task-controls button:hover,
.task-controls select:hover {
  background: #f5f6f2;
}

.task-controls .delete-button {
  color: #a43d35;
}

.task-title-done {
  color: #858a82;
  text-decoration: line-through;
}

.footer {
  padding-top: 42px;
  color: #959a92;
  text-align: center;
  font-size: 11px;
}

.footer span {
  margin: 0 5px;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (min-width: 1500px) {
  .main-content {
    margin-right: auto;
  }
}

@media (max-width: 1050px) {
  .sidebar {
    width: 205px;
    padding: 25px 16px;
  }

  .main-content {
    margin-left: 205px;
    padding: 30px 26px;
  }

  .task-toolbar {
    grid-template-columns: 1fr 1fr;
  }

  .search-box {
    grid-column: 1 / -1;
  }
}

@media (max-width: 650px) {
  .sidebar {
    position: static;
    width: 100%;
    padding: 16px 20px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    margin-bottom: 18px;
  }

  .sidebar .nav-heading,
  .sidebar-bottom {
    display: none;
  }

  .sidebar nav {
    display: flex;
    gap: 8px;
  }

  .nav-link {
    padding: 9px 12px;
  }

  .main-content {
    margin-left: 0;
    padding: 24px 17px;
  }

  h1 {
    font-size: 23px;
  }

  .welcome {
    min-height: 160px;
    padding: 24px 20px;
  }

  .welcome h2 {
    font-size: 24px;
  }

  .welcome-mark {
    font-size: 65px;
    margin-right: 0;
  }

  .stats {
    gap: 9px;
    margin-bottom: 30px;
  }

  .stat-card {
    padding: 14px 11px;
  }

  .stat-card p {
    min-height: 28px;
    font-size: 10px;
  }

  .stat-card strong {
    font-size: 24px;
  }

  .section-heading h2 {
    font-size: 20px;
  }

  .task-toolbar {
    grid-template-columns: 1fr;
  }

  .search-box {
    grid-column: auto;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .task-form {
    padding: 17px;
  }

  .footer {
    padding-top: 30px;
  }
}
